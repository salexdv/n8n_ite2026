          "id": "xZaKVCTrORs7LywD",
          "name": "MongoDB feedback"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const j = item.json;\n  const { id: mongoInsertedId, _id, feedback_id, ...body } = j;\n  return {\n    json: {\n      ok: true,\n      id: feedback_id,\n      record: {\n        id: feedback_id,\n        ...body\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
