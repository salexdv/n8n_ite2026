{
  "name": "ITE2026-Feedback",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const src = $json;\nconst feedbackId =\n  src.headers?.['x-form-answer-id'] ??\n  src.headers?.['x-delivery-id'] ??\n  `${Date.now()}-${Math.random().toString(16).slice(2)}`;\n\nreturn [{\n  json: {\n    feedback_id: String(feedbackId),\n    ...src.body,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "5862b58c-2309-46be-a110-5acabe82b65f",
      "name": "Prepare SET"
    },
