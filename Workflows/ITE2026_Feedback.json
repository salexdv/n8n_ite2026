          "id": "xZaKVCTrORs7LywD",
          "name": "MongoDB feedback"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const records = $input.all()\n  .map(item => item.json)\n  .filter(j => j && Object.keys(j).length > 0)\n  .map(j => {\n    const { _id, feedback_id, ...body } = j;\n    return {\n      id: feedback_id,\n      ...body\n    };\n  });\n\nreturn [{\n  json: {\n    ok: true,\n    count: records.length,\n    records\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        224
      ],
      "id": "b107f4b7-d109-4a36-8b2a-7e402abdcc71",
      "name": "Format GET"
    },
    {
      "parameters": {
        "jsCode": "const id = $json.query?.id ?? $json.body?.id;\n\nif (id === undefined || id === null || String(id).trim() === '') {\n  throw new Error('action=ack requires id in query (?action=ack&id=...) or body ({\"id\":\"...\"})');\n}\n\nreturn [{\n  json: {\n    id: String(id)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
